#!/bin/bash
# Launcher for autopilot.py (also what launchd runs).
DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
LOCAL_STATE="$HOME/Library/Application Support/PURSUIT_AUTOPILOT"
if [ -x "$LOCAL_STATE/venv-local/bin/python" ] && [ -f "$LOCAL_STATE/runtime/autopilot.py" ]; then
  export PURSUIT_OUT="$LOCAL_STATE/clips"
  exec "$LOCAL_STATE/venv-local/bin/python" "$LOCAL_STATE/runtime/autopilot.py" "$@"
fi
exec "$DIR/.venv/bin/python" "$DIR/autopilot.py" "$@"
