# Optional overrides. The normal macOS setup stores the Post for Me key in
# Keychain, so no .env file is required and this project does not auto-load one.
PURSUIT_POSTFORME_KEY=replace_with_your_own_key
PURSUIT_TZ=America/Denver

# Test/development overrides only:
# PURSUIT_OUT=/absolute/path/to/output
# PURSUIT_STATE_DIR=/absolute/path/to/private/state
# PURSUIT_LOG=/absolute/path/to/autopilot.log
# PURSUIT_POSTFORME_API=https://api.postforme.dev

# Podcast / Spotify RSS distribution (off until ./autopilot podcast-auto on)
# Automatic RSS publication: run ./autopilot podcast-setup (see SPOTIFY_SETUP.md).
# Setup stores R2 keys privately outside the repo and selects mode r2.
# The default is automatic RSS publication through our Cloudflare server.
# PURSUIT_PODCAST_MODE=r2
# PURSUIT_PODCAST_TITLE=PURSUIT with Anya Postnikov
# PURSUIT_PODCAST_DESCRIPTION=PURSUIT with Anya Postnikov.
# PURSUIT_PODCAST_AUTHOR=Anya Postnikov
# PURSUIT_PODCAST_EXPLICIT=false
# PURSUIT_PODCAST_SOURCE_DIR=/absolute/path/to/exported/full-episode-media
# Optional self-hosted RSS fallback:
# PURSUIT_PODCAST_MODE=self_hosted
# PURSUIT_PODCAST_PUBLIC_DIR=/absolute/path/to/public/feed/folder
# PURSUIT_PODCAST_MEDIA_BASE_URL=https://example.com/podcast/media
# PURSUIT_PODCAST_FEED_URL=https://example.com/podcast/feed.xml
# PURSUIT_PODCAST_OWNER_EMAIL=owner@example.com
# PURSUIT_PODCAST_ARTWORK_URL=https://example.com/podcast/cover.jpg

# AI provider (Codex CLI signed in with ChatGPT; no API key is ever used)
# PURSUIT_LLM=codex                 # or claude
# PURSUIT_LLM_FALLBACK=none        # default none; set to claude only if you want Claude as a backup
# PURSUIT_CODEX_MODEL=              # optional; empty = Codex's own default
